# Copy to .env.local and fill in. NEVER commit .env.local.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser. Everything else is server-only.

# ---- App ----
APP_BASE_URL=http://localhost:3000

# ---- Supabase (Phase 2) ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Privy (Phase 3) ----
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Authorization key used by the backend as the delegated signer (Phase 3)
PRIVY_AUTHORIZATION_PRIVATE_KEY=
PRIVY_SIGNER_KEY_QUORUM_ID=

# ---- Solana Devnet (Phase 4) ----
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# Fee payer (sponsor). JSON byte array from `solana-keygen`. Keep only a few devnet SOL in it.
SPONSOR_PRIVATE_KEY=

# ---- WhatsApp Cloud API (Phase 5) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta app secret: used to verify X-Hub-Signature-256 on every webhook POST
WHATSAPP_APP_SECRET=
# Any string you invent; must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# ---- Conversion (SIMULATED, not a live market rate) ----
NGN_PER_ZAR=45
ZAR_PER_USD=18
PLATFORM_FEE_BPS=200
# Multiplies the on-chain USDC amount (1 = exact). Lower it if the Circle faucet limits you.
DEMO_USDC_SCALE=1

# ---- Limits (ZAR) ----
MIN_SEND_ZAR=10
MAX_SEND_ZAR=5000
STEP_UP_ABOVE_ZAR=1000
DAILY_LIMIT_ZAR=5000

# ---- Security ----
# Random 32+ char string used when hashing PINs
PIN_PEPPER=
# Basic-auth gate for the dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
